#version 300 es

#pragma exclude_renderers hlsl50 vulkan

#pragma precision highp float

#pragma global
#pragma end

#pragma input attributes
in vec2 a_position;
in vec2 a_texcoord0;
#pragma end

#pragma varying varyings
highp vec2 uv0;
#pragma end

#pragma output targets
out vec4 o_fragColor;
#pragma end

#pragma vs attributes varyings
#pragma end

#pragma fs varyings targets
uniform sampler2D u_sourceTexture;
uniform sampler2D u_baseTexure;
uniform sampler2D u_maskTexture;
uniform int u_hasSourceTexture;
uniform int u_hasBaseTexture;
uniform int u_hasMatte;
uniform int u_enableMatte;
uniform int u_matteMode;
uniform int u_hasBlend;
uniform int u_blendMode;
uniform int u_layerType;
uniform float u_layerOpacity;
uniform int u_hasTrs;
uniform mat4 u_mvMat;
uniform mat4 u_pMat;
uniform float u_alpha;
uniform float u_mirrorEdge;

#define TRUE 1
#define FALSE 0
#define LAYER_TYPE_ADJUSTMENT 1

#define MATTE_MODE_ALPHA 0
#define MATTE_MODE_LUMA 1
#define MATTE_MODE_ALPHA_INVERTED 2
#define MATTE_MODE_LUMA_INVERTED 3

#define BLEND_MODE_NORMAL 0
#define BLEND_MODE_ADD 1
#define BLEND_MODE_MULTIPLY 2
#define BLEND_MODE_DIFFERENCE 3
#define BLEND_MODE_OVERLAY 4
#define BLEND_MODE_DARKEN 5
#define BLEND_MODE_LIGHTEN 6
#define BLEND_MODE_SOFT_LIGHT 7
#define BLEND_MODE_HARD_LIGHT 8
#define BLEND_MODE_HUE 9
#define BLEND_MODE_SATURATION 10
#define BLEND_MODE_COLOR 11
#define BLEND_MODE_SCREEN 12
#define BLEND_MODE_COLOR_BURN 13
#define BLEND_MODE_LINEAR_BURN 14
#define BLEND_MODE_COLOR_DODGE 15
#define BLEND_MODE_LINEAR_DODGE 16
#define BLEND_MODE_VIVID_LIGHT 17
#define BLEND_MODE_LINEAR_LIGHT 18
#define BLEND_MODE_PIN_LIGHT 19
#define BLEND_MODE_HARD_MIX 20
#define BLEND_MODE_EXCLUSION 21
#define BLEND_MODE_SUBTRACT 22
#define BLEND_MODE_DIVIDE 23
#define BLEND_MODE_LUMINOSITY 24
#define BLEND_MODE_LIGHTER_COLOR 25
#define BLEND_MODE_DARKER_COLOR 26
#define BLEND_MODE_DISSOLVE 27

const float EPS = 1e-5;

float random(vec2 st)
{
    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);
}

#define BlendOverlayf(s, d)      (d < 0.5 ? (2.0 * d * s) : (1.0 - 2.0 * (1.0 - d) * (1.0 - s))) 
#define BlendOverlay(s, d)       vec3(BlendOverlayf(s.r, d.r), BlendOverlayf(s.g, d.g), BlendOverlayf(s.b, d.b))
#define BlendScreen(s, d)        (s + d - s * d)
#define BlendMultiply(s, d)      (s * d)
#define BlendDifference(s, d)    (abs(s - d))
#define BlendAdd(s, d)           (s + d)
#define BlendSubtract(s, d)      max(vec3(0.0), (d - s))
#define BlendDarken(s, d)        min(s, d)
#define BlendLighten(s, d)       max(s, d)
#define BlendExclusion(s, d)     (d + s - 2.0 * d * s)

float softLightf(float s, float d)
{
    return (s < 0.5) ? d - (1.0 - 2.0 * s) * d * (1.0 - d) : (d < 0.25) ? d + (2.0 * s - 1.0) * d * ((16.0 * d - 12.0) * d + 3.0) : d + (2.0 * s - 1.0) * (sqrt(d) - d);
}
vec3 BlendSoftLight(vec3 s, vec3 d)
{
    return vec3(softLightf(s.r, d.r), softLightf(s.g, d.g), softLightf(s.b, d.b));
}

float hardLightf(float s, float d)
{
    return (s < 0.5) ? 2.0 * s * d : 1.0 - 2.0 * (1.0 - s) * (1.0 - d);
}
vec3 BlendHardLight(vec3 s, vec3 d)
{
    return vec3(hardLightf(s.r, d.r), hardLightf(s.g, d.g), hardLightf(s.b, d.b));
}

float getLuminosity(vec3 color)
{
    return dot(color, vec3(0.299, 0.587, 0.114));
}

vec3 setLuminosity(vec3 c, float lum)
{
    float d = lum - getLuminosity(c);
    c.rgb += vec3(d);

    // clip back into legal range
    lum = getLuminosity(c);
    float cMin = min(c.r, min(c.g, c.b));
    float cMax = max(c.r, max(c.g, c.b));

    if (cMin < 0.0) {
        c = mix(vec3(lum, lum, lum), c, lum / (lum - cMin));
    }

    if (cMax > 1.0) {
        c = mix(vec3(lum, lum, lum), c, (1. - lum) / (cMax - lum));
    }

    return c;
}

// from https://www.scratchapixel.com/lessons/3d-basic-rendering/ray-tracing-rendering-a-triangle/moller-trumbore-ray-triangle-intersection
// ray and triangle hit test
//  @param orig...origin of ray
//  @param dir...ray direction
//  @param a,b,c....triangle vertices
//  @return vec3(0,0,0) if ray is not hit triangle
vec4 hit(vec3 orig, vec3 dir, vec3 a, vec3 b, vec3 c)
{
    const float eps = 1e-7;
    vec3 ab = b - a;
    vec3 ac = c - a;

    vec3 n = cross(dir, ac);

    float det = dot(ab, n);

    if (det <= eps) {
        return vec4(-1., -1., -1., -1.);
    }
    // if the determinant is negative the triangle is backfacing
    // if the determinant is close to 0, the ray misses the triangl
    vec3 ao = orig - a;
    float u = dot(ao, n) / det;
    if (u < 0.0 || u > 1.0) {
        return vec4(-1., -1., -1., -1.);
    }

    vec3 e = cross(ao, ab);
    float v = dot(dir, e) / det;
    if (v < 0.0 || u + v > 1.0) {
        return vec4(-1., -1., -1., -1.);
    }

    float t = dot(ac, e) / det;
    return vec4(u, v, t, 1.);
}

vec2 hitRect(mat4 mvM, mat4 pM, vec2 uv)
{
    const float offset = 1e-5;
    const vec2 c1 = vec2(-4.5, -4.5);
    const vec2 c2 = vec2(5.5, -4.5);
    const vec2 c3 = vec2(-4.5, 5.5);
    const vec2 c4 = vec2(5.5, 5.5);
    vec4 a = mvM * vec4(-10.0, -10.0, 0.0, 1.0);
    vec4 b = mvM * vec4(10.0, -10.0, 0.0, 1.0);
    vec4 c = mvM * vec4(-10.0, 10.0, 0.0, 1.0);
    vec4 d = mvM * vec4(10.0, 10.0, 0.0, 1.0);
    vec3 b_o_x = (mvM * vec4(10.0+offset, -10.0, 0.0, 1.0)).xyz;
    vec3 b_o_y = (mvM * vec4(10.0, -10.0-offset, 0.0, 1.0)).xyz;
    vec3 c_o_y = (mvM * vec4(-10.0, 10.0+offset, 0.0, 1.0)).xyz;
    vec3 c_o_x = (mvM * vec4(-10.0-offset, 10.0, 0.0, 1.0)).xyz;

    vec4 pos = pM * vec4(uv * 2.0 - 1.0, 0., 1.);
    vec3 p = pos.xyz / pos.w;

    // calc ray direction
    vec3 camera = vec3(0);
    vec3 dir = p - camera;
    dir = normalize(dir);

    vec4 test1 = hit(camera, dir, a.xyz, b_o_x, c_o_y);
    vec4 test2 = hit(camera, dir, c_o_x, b_o_y, d.xyz);
    vec4 test3 = hit(camera, dir, a.xyz, c_o_y, b_o_x);
    vec4 test4 = hit(camera, dir, c_o_x, d.xyz, b_o_y);

    vec2 resUV1 = (1.0 - test1.x - test1.y) * c1 + test1.x * c2 + test1.y * c3;
    vec2 resUV2 = (1.0 - test2.x - test2.y) * c3 + test2.x * c2 + test2.y * c4;
    vec2 resUV3 = (1.0 - test3.x - test3.y) * c1 + test3.x * c3 + test3.y * c2;
    vec2 resUV4 = (1.0 - test4.x - test4.y) * c3 + test4.x * c4 + test4.y * c2;

    vec2 resUV = step(0., test1.w) * resUV1
               + step(test1.w, 0.) * step(0., test2.w) * resUV2
               + step(test1.w, 0.) * step(test2.w, 0.) * step(0., test3.w) * resUV3
               + step(test1.w, 0.) * step(test2.w, 0.) * step(test3.w, 0.) * step(0., test4.w) * resUV4
               + step(test1.w, 0.) * step(test2.w, 0.) * step(test3.w, 0.) * step(test4.w, 0.) * vec2(-10000.);

    return resUV;
}

float uvProtect(vec2 uv)
{
    vec2 uvp = step(vec2(0.0), uv) * step(uv, vec2(1.0));
    return uvp.x * uvp.y;
}

vec2 uvMirror(vec2 x)
{
    return abs(mod(x - 1., 2.) - 1.);
}

vec4 mattePass(vec4 srcColor)
{
    vec4 maskColor = vec4(0);
    if (u_enableMatte == TRUE) {
        maskColor = texture(u_maskTexture, uv0);
    }

    float factor = maskColor.a;
    if (u_matteMode == MATTE_MODE_LUMA) {
        factor = getLuminosity(maskColor.rgb);
    } else if (u_matteMode == MATTE_MODE_ALPHA_INVERTED) {
        factor = 1.0 - maskColor.a;
    } else if (u_matteMode == MATTE_MODE_LUMA_INVERTED) {
        factor = 1.0 - getLuminosity(maskColor.rgb);
    }

    return srcColor * factor;
}

vec3 setSaturationMinMidMax(vec3 cSorted, float s)
{
    if (cSorted.z > cSorted.x) {
        cSorted.y = (((cSorted.y - cSorted.x) * s) / (cSorted.z - cSorted.x));
        cSorted.z = s;
    } else {
        cSorted.y = 0.0;
        cSorted.z = 0.0;
    }

    cSorted.x = 0.0;

    return cSorted;
}

float getSaturation(vec3 c)
{
    return max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b));
}

vec3 setSaturation(vec3 c, float s)
{
    if (c.r <= c.g && c.r <= c.b) {
        if (c.g <= c.b) {
            c.rgb = setSaturationMinMidMax(c.rgb, s);
        } else {
            c.rbg = setSaturationMinMidMax(c.rbg, s);
        }
    } else if (c.g <= c.r && c.g <= c.b) {
        if (c.r <= c.b) {
            c.grb = setSaturationMinMidMax(c.grb, s);
        } else {
            c.gbr = setSaturationMinMidMax(c.gbr, s);
        }
    } else {
        if (c.r <= c.g) {
            c.brg = setSaturationMinMidMax(c.brg, s);
        } else {
            c.bgr = setSaturationMinMidMax(c.bgr, s);
        }
    }

    return c;
}

vec3 BlendHue(vec3 s, vec3 d)
{
    return setLuminosity(setSaturation(s, getSaturation(d)), getLuminosity(d));
}

vec3 BlendSaturation(vec3 s, vec3 d)
{
    return setLuminosity(setSaturation(d, getSaturation(s)), getLuminosity(d));
}

vec3 BlendColor(vec3 s, vec3 d)
{
    return setLuminosity(s, getLuminosity(d));
}

vec3 BlendDarkerColor(vec3 s, vec3 d)
{
    return getLuminosity(d) <= getLuminosity(s) ? d : s;
}

vec3 BlendLighterColor(vec3 s, vec3 d)
{
    return getLuminosity(d) > getLuminosity(s) ? d : s;
}

vec3 BlendLuminosity(vec3 s, vec3 d)
{
    return setLuminosity(d, getLuminosity(s));
}

float colorBurn(float s, float d)
{
    if (d >= 1.0) {
        return 1.0;
    } else if (s <= 0.0) {
        return 0.0;
    } else {
        return 1.0 - min(1.0, (1.0 - d) / s);
    }
}
vec3 BlendColorBurn(vec3 s, vec3 d)
{
    return vec3(colorBurn(s.r, d.r), colorBurn(s.g, d.g), colorBurn(s.b, d.b));
}

float linearBurn(float s, float d)
{
    return max(0.0, d + s - 1.0);
}
vec3 BlendLinearBurn(vec3 s, vec3 d)
{
    return vec3(linearBurn(s.r, d.r), linearBurn(s.g, d.g), linearBurn(s.b, d.b));
}

float colorDodge(float s, float d)
{
    if (d <= 0.0) {
        return 0.0;
    }
    if (s >= 1.0) {
        return 1.0;
    } else {
        return min(1.0, d / (1.0 - s));
    }
}
vec3 BlendColorDodge(vec3 s, vec3 d)
{
    return vec3(colorDodge(s.r, d.r), colorDodge(s.g, d.g), colorDodge(s.b, d.b));
}

float linearDodge(float s, float d)
{
    return min(1.0, d + s);
}
vec3 BlendLinearDodge(vec3 s, vec3 d)
{
    return vec3(linearDodge(s.r, d.r), linearDodge(s.g, d.g), linearDodge(s.b, d.b));
}

float vividLight(float s, float d)
{
    return (s <= 0.5) ? colorBurn(d, 2.0 * s) : colorDodge(d, 2.0 * (s - 0.5));
}
vec3 BlendVividLight(vec3 s, vec3 d)
{
    return vec3(vividLight(s.r, d.r), vividLight(s.g, d.g), vividLight(s.b, d.b));
}

float linearLight(float s, float d)
{
    return (s <= 0.5) ? linearBurn(d, 2.0 * s) : linearDodge(d, 2.0 * (s - 0.5));
}
vec3 BlendLinearLight(vec3 s, vec3 d)
{
    return vec3(linearLight(s.r, d.r), linearLight(s.g, d.g), linearLight(s.b, d.b));
}

float pinLight(float s, float d)
{
    return (s <= 0.5) ? min(d, 2.0 * s) : max(d, 2.0 * (s - 0.5));
}
vec3 BlendPinLight(vec3 s, vec3 d)
{
    return vec3(pinLight(s.r, d.r), pinLight(s.g, d.g), pinLight(s.b, d.b));
}

float hardMix(float s, float d)
{
    return (d + s >= 1.0) ? 1.0 : 0.0;
}
vec3 BlendHardMix(vec3 s, vec3 d)
{
    return vec3(hardMix(s.r, d.r), hardMix(s.g, d.g), hardMix(s.b, d.b));
}

float dividef(float s, float d)
{
    return s > 0.0 ? min(1.0, d / s) : 1.0;
}
vec3 BlendDivide(vec3 s, vec3 d)
{
    return vec3(dividef(s.r, d.r), dividef(s.g, d.g), dividef(s.b, d.b));
}

vec4 blendPass(vec4 srcColor, vec4 baseColor)
{
    srcColor.rgb /= max(srcColor.a, EPS);
    baseColor.rgb /= max(baseColor.a, EPS);

    vec4 blendColor = baseColor;

#ifdef BLEND_MODE_ADD
    if (u_blendMode == BLEND_MODE_ADD) {
        blendColor.rgb = BlendAdd(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_MULTIPLY
    if (u_blendMode == BLEND_MODE_MULTIPLY) {
        blendColor.rgb = BlendMultiply(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_DIFFERENCE
    if (u_blendMode == BLEND_MODE_DIFFERENCE) {
        blendColor.rgb = BlendDifference(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_OVERLAY
    if (u_blendMode == BLEND_MODE_OVERLAY) {
        blendColor.rgb = BlendOverlay(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_DARKEN
    if (u_blendMode == BLEND_MODE_DARKEN) {
        blendColor.rgb = BlendDarken(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_LIGHTEN
    if (u_blendMode == BLEND_MODE_LIGHTEN) {
        blendColor.rgb = BlendLighten(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_SOFT_LIGHT
    if (u_blendMode == BLEND_MODE_SOFT_LIGHT) {
        blendColor.rgb = BlendSoftLight(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_HARD_LIGHT
    if (u_blendMode == BLEND_MODE_HARD_LIGHT) {
        blendColor.rgb = BlendHardLight(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_HUE
    if (u_blendMode == BLEND_MODE_HUE) {
        blendColor.rgb = BlendHue(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_SATURATION
    if (u_blendMode == BLEND_MODE_SATURATION) {
        blendColor.rgb = BlendSaturation(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_COLOR
    if (u_blendMode == BLEND_MODE_COLOR) {
        blendColor.rgb = BlendColor(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_SCREEN
    if (u_blendMode == BLEND_MODE_SCREEN) {
        blendColor.rgb = BlendScreen(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_COLOR_BURN
    if (u_blendMode == BLEND_MODE_COLOR_BURN) {
        blendColor.rgb = BlendColorBurn(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_LINEAR_BURN
    if (u_blendMode == BLEND_MODE_LINEAR_BURN) {
        blendColor.rgb = BlendLinearBurn(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_COLOR_DODGE
    if (u_blendMode == BLEND_MODE_COLOR_DODGE) {
        blendColor.rgb = BlendColorDodge(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_LINEAR_DODGE
    if (u_blendMode == BLEND_MODE_LINEAR_DODGE) {
        blendColor.rgb = BlendLinearDodge(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_VIVID_LIGHT
    if (u_blendMode == BLEND_MODE_VIVID_LIGHT)
    {
        blendColor.rgb = BlendVividLight(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_LINEAR_LIGHT
    if (u_blendMode == BLEND_MODE_LINEAR_LIGHT) {
        blendColor.rgb = BlendLinearLight(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_PIN_LIGHT
    if (u_blendMode == BLEND_MODE_PIN_LIGHT) {
        blendColor.rgb = BlendPinLight(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_HARD_MIX
    if (u_blendMode == BLEND_MODE_HARD_MIX) {
        blendColor.rgb = BlendHardMix(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_EXCLUSION
    if (u_blendMode == BLEND_MODE_EXCLUSION) {
        blendColor.rgb = BlendExclusion(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_SUBTRACT
    if (u_blendMode == BLEND_MODE_SUBTRACT) {
        blendColor.rgb = BlendSubtract(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_DIVIDE
    if (u_blendMode == BLEND_MODE_DIVIDE) {
        blendColor.rgb = BlendDivide(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_LUMINOSITY
    if (u_blendMode == BLEND_MODE_LUMINOSITY) {
        blendColor.rgb = BlendLuminosity(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_LIGHTER_COLOR
    if (u_blendMode == BLEND_MODE_LIGHTER_COLOR) {
        blendColor.rgb = BlendLighterColor(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_DARKER_COLOR
    if (u_blendMode == BLEND_MODE_DARKER_COLOR) {
        blendColor.rgb = BlendDarkerColor(srcColor.rgb, baseColor.rgb);
    } else
#endif
#ifdef BLEND_MODE_DISSOLVE
    if (u_blendMode == BLEND_MODE_DISSOLVE) {
        if (srcColor.a == 1.0 || (srcColor.a > 0.0 && srcColor.a > random(uv0))) {
            blendColor.rgb = srcColor.rgb;
        }
    } else
#endif
    {
        // normal
        blendColor.rgb = srcColor.rgb;
    }

    vec4 result = vec4(0.);

    if (u_layerType == LAYER_TYPE_ADJUSTMENT) {
        float matte = 1.0;
        if (u_hasMatte == TRUE) {
            matte = mattePass(vec4(1.0)).a;
        }
        result = mix(baseColor, vec4(blendColor.rgb, srcColor.a), u_layerOpacity * matte);
        result.rgb *= result.a;
    } else {
        // The following code is to perform "alpha compositing". Please NOTICE that:
        // the input "srcColor" and "baseColor" have straight alpha, while the "result"
        // has premultiplied alpha (because result.rgb does NOT divided by result.a)..
        result.rgb = baseColor.rgb * baseColor.a * (1.0 - srcColor.a) +
            srcColor.rgb * srcColor.a * (1.0 - baseColor.a) +
            srcColor.a * baseColor.a * blendColor.rgb;
        result.a = srcColor.a + baseColor.a * (1.0 - srcColor.a);
    }

    return result;
}

#pragma end

void vertex()
{
    gl_Position = sign(vec4(a_position.xy, 0.0, 1.0));
    uv0 = a_texcoord0;
}

void fragment()
{
    vec4 baseColor = vec4(0);
    if (u_hasBlend == TRUE) {
        if (u_hasBaseTexture == TRUE) {
            baseColor = texture(u_baseTexure, uv0);
        }
        if (u_hasSourceTexture == FALSE) {
            o_fragColor = baseColor;
            return;
        }
    }

    vec4 result = vec4(0);

    if (u_hasTrs == TRUE) {
        vec2 uv = hitRect(u_mvMat, u_pMat, uv0);
        uv = step(u_mirrorEdge, 0.5) * uv + (1.0 - step(u_mirrorEdge, 0.5)) * uvMirror(uv);
        result = texture(u_sourceTexture, uv) * u_alpha * uvProtect(uv);
    } else if (u_hasSourceTexture == TRUE) {
        result = texture(u_sourceTexture, uv0);
    }

    if ((u_layerType != LAYER_TYPE_ADJUSTMENT) && (u_hasMatte == TRUE)) {
        result = mattePass(result);
    }

    if (u_hasBlend == TRUE) {
        result = blendPass(result, baseColor);
    }

    o_fragColor = result;
}
