{
  "key": "LumiTurbulenceDisplacement",
  "category": "Distort",
  "desc": "基于分形噪声驱动的多通道位移效果，可做热浪、液体折射、碎裂扭曲和风暴波纹等风格化形变。",
  "preset": [
    {
      "name": "none",
      "desc": "关闭湍流位移，仅保留原图，方便与其他风格做 A/B 对比。"
    },
    {
      "name": "default",
      "desc": "基础湍流扭曲，轻度分形噪声位移，适合直接预览效果结构。"
    },
    {
      "name": "heatHaze",
      "desc": "偏热浪空气折射感，形变柔和、流动缓慢，适合背景扰动。"
    },
    {
      "name": "liquidWarp",
      "desc": "偏液体折射和流体拉扯，扭曲幅度更大，画面有轻微收缩感。"
    },
    {
      "name": "fracturedGlass",
      "desc": "偏碎裂玻璃/棱镜扭曲，细节更密、更硬，分块感更明显。"
    },
    {
      "name": "stormRipple",
      "desc": "偏风暴波纹和电流扰动，演化更快，方向性和脉冲感更强。"
    }
  ],
  "subProperties": [
